														"type": "PipelineReference"
													},
													"waitOnCompletion": true,
													"parameters": {
														"directory_name": {
															"value": "@item().directory_name",
															"type": "Expression"
														},
														"file_name": {
															"value": "@item().file_name",
															"type": "Expression"
														}
													}
												}
											}
										]
